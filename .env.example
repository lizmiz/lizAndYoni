# Pooled connection (used by the running app). On a single local Postgres, DIRECT_URL
# can just be the same value — the pooled/direct split only matters with a serverless
# Postgres provider (Neon, Vercel Postgres) that fronts connections with PgBouncer.
DATABASE_URL="postgresql://user:password@localhost:5432/lizandyoni"
# Direct (non-pooled) connection — required for `prisma migrate deploy` to work.
DIRECT_URL="postgresql://user:password@localhost:5432/lizandyoni"

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_SECRET=""

ALLOWED_EMAILS="lizmiz@gmail.com,yonibarel.adv@gmail.com"

ANTHROPIC_API_KEY=""
